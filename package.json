{
  "name": "lineageguard-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "agents:init": "playwright init-agents --loop=codex --project=chromium",
    "build": "pnpm build:cli && pnpm build:web",
    "build:cli": "tsc -p tsconfig.build.json",
    "build:web": "next build --webpack",
    "demo": "tsx src/cli.ts --request \"Rename column customer_id to customer_key in dataset snowflake:b2fd91.order_entry_db.analytics.order_details\"",
    "dev": "next dev --webpack",
    "example:agent": "tsx scripts/generate-agent-example.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare:pr-impact": "tsx scripts/prepare-pr-impact.ts",
    "render:check": "tsx scripts/validate-render-blueprint.ts",
    "security:scan": "tsx scripts/scan-repository-secrets.ts",
    "security:scan:history": "tsx scripts/scan-repository-secrets.ts --history",
    "start": "node dist/cli.js",
    "start:public-replay": "node dist/hosting/start-public-replay.js",
    "start:web": "next start",
    "submission:check": "tsx scripts/validate-submission-assets.ts",
    "summary:pr-impact": "tsx scripts/append-pr-impact-summary.ts",
    "test": "vitest run --exclude \"tests/integration/**\" --exclude \"tests/e2e/**\" --exclude \"tests/exploratory/**\" --exclude \".worktrees/**\"",
    "test:e2e": "playwright test",
    "test:exploratory": "tsx scripts/run-midscene-exploratory.ts",
    "test:integration": "vitest run tests/integration/datahub-mcp.integration.test.ts",
    "test:openai": "vitest run tests/integration/openai-agent.integration.test.ts",
    "test:runtime-mode": "vitest run tests/integration/runtime-mode-page.integration.test.ts",
    "test:submission": "vitest run scripts/validate-submission-assets.test.ts scripts/scan-repository-secrets.test.ts",
    "typecheck": "tsc --noEmit",
    "verify:offline": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm render:check && pnpm build && pnpm test:runtime-mode && pnpm test:e2e --project=chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@openai/agents": "0.13.5",
    "next": "16.2.11",
    "node-sql-parser": "5.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@midscene/web": "1.10.7",
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
